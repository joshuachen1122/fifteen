# Copy to .env for local runs (`python main.py`). On Fly, set secrets with `fly secrets set`.
# Names match the secrets already configured on the rocket-trading Fly app.

# --- Secrets ---------------------------------------------------------------
ANTHROPIC_API_KEY=            # LLM risk gate; without it every candidate is vetoed
KALSHI_KEY_ID=                # Kalshi API key id (KALSHI_API_KEY_ID is also accepted)
KALSHI_PRIVATE_KEY=           # RSA private key PEM contents, or use KALSHI_PRIVATE_KEY_PATH
# KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Kalshi credentials are required even for paper trading: the order-book WebSocket rejects
# unauthenticated connections.

# --- Trading mode & real-money caps ------------------------------------------
KALSHI_ENV=demo               # demo | prod
TRADING_ENABLED=false         # boot default; the dashboard toggle is persisted and takes precedence
ALLOW_LIVE_TRADING=false      # server-side guard: live trading is impossible unless this is true
DASHBOARD_PASSWORD=           # HTTP basic auth for the dashboard; required before live trading
MAX_TRADE_USD=1.00            # max all-in cost (price + Kalshi fee) of one order
MAX_DAILY_TRADE_USD=100.00    # max all-in cost of all orders per UTC day
PAPER_STARTING_BALANCE_CENTS=100000
KALSHI_RATE_LIMIT_RPS=10

# --- LLM -------------------------------------------------------------------
BTC15M_LLM_MODEL=claude-sonnet-5-5
BTC15M_LLM_EFFORT=medium

# --- Storage & runtime -----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./btc_agent.db   # Fly: sqlite+aiosqlite:////data/agent.db
SPOT_SOURCE=coinbase          # coinbase | binance
LOG_LEVEL=INFO
WEB_ENABLED=true
HOST=0.0.0.0
PORT=8080

# --- LLM spend controls (defaults shown) -------------------------------------
# Free checks run before every paid LLM call; at ~$0.004-0.006 per call these bound the bill.
LLM_DAILY_BUDGET_USD=5.0       # hard cap; when spent, no LLM calls and no new trades until 00:00 UTC
LLM_MAX_CALLS_PER_MARKET=4     # per 15-minute contract (96 contracts/day)
LLM_REASK_EDGE_STEP=0.02       # after a veto, re-ask only if the edge improves by 2 points
LLM_MIN_SECONDS_REMAINING=60
MAX_PLAUSIBLE_EDGE=0.30        # bigger edges are treated as bad quotes and never sent to the LLM
LLM_COOLDOWN_SEC=60

# --- Scheduler knobs (defaults shown) ---------------------------------------
SPOT_PERSIST_INTERVAL_SEC=5
SETTLEMENT_POLL_SEC=180
SNAPSHOT_INTERVAL_SEC=5         # unconditional market snapshots (~17k rows/day) for research & backtests
EVALUATION_INTERVAL_SEC=3600    # hourly report-only evaluation, run as a separate low-priority process
AUTO_APPLY_PARAMS=true          # apply tuned params only if they beat the active ones on held-out trades
AUTO_APPLY_MIN_TRADES=300       # ...with at least this many replayable trades
AUTO_APPLY_COOLDOWN_HOURS=24    # ...and at most once per this many hours

# --- Pricing model -------------------------------------------------------------
# KXBTC15M settles on the 60-second average of CF Benchmarks' BRTI before the close. Both the
# spot model and the settlement-average model are recorded on every snapshot; "auto" trades
# whichever the hourly evaluation scores better once it has MODEL_MIN_CONTRACTS settled contracts.
PRICING_MODEL=auto              # auto | spot | settlement
MARKET_BLEND=auto               # auto: trade on w*model + (1-w)*market mid with w fitted hourly | off
MODEL_MIN_CONTRACTS=50
PAPER_MARKET_BLEND=false        # the blend protects live money; paper trades the raw model so experiments keep data
# Spot calibration: Coinbase is shifted by the measured gap to the CF Benchmarks index (median of the
# last INDEX_GAP_CONTRACTS strikes), and 5-minute volatility is floored by LONG_VOL_LOOKBACK_SEC realized.
INDEX_GAP_CORRECTION=true
INDEX_GAP_CONTRACTS=8
LONG_VOL_LOOKBACK_SEC=14400      # 0 disables the volatility floor

# --- Shadow experiments (never place orders) ------------------------------------
MAKER_SHADOW_ENABLED=true       # record the resting bid we could have posted per LLM-reviewed candidate
MAKER_TTL_SEC=180               # ...and how long it would rest before being cancelled
LLM_REPLAY_MODEL=claude-haiku-5-5  # re-ask settled LLM decisions through a cheaper model
LLM_REPLAY_EFFORT=low
LLM_REPLAY_DAILY_USD=0.25       # 0 disables replays
